{
  "name": "mi-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "pnpm check && vp run -r test && vp run -r build",
    "prepare": "vp config",
    "check": "pnpm lint && vp check --no-lint",
    "lint": "vp lint && pnpm lint:md && pnpm lint:spell",
    "lint:md": "markdownlint \"**/*.md\" --ignore-path .gitignore",
    "lint:spell": "cspell --no-must-find-files --no-progress"
  },
  "devDependencies": {
    "cspell": "catalog:",
    "markdownlint-cli": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.9.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "26.9.0"
  }
}
